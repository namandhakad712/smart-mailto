{
  "name": "@smart-mailto/svelte",
  "version": "0.2.1",
  "description": "Svelte action and global initializer for the smart-mailto webmail provider picker",
  "keywords": [
    "mailto",
    "email",
    "webmail",
    "picker",
    "svelte",
    "gmail",
    "typescript"
  ],
  "homepage": "https://smart-mailto.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/namandhakad712/smart-mailto.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/namandhakad712/smart-mailto/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "svelte": ">=4.0.0"
  },
  "dependencies": {
    "@smart-mailto/core": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "svelte": "^4.2.19",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
