{
  "name": "smart-mailto",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for smart-mailto — geo-aware webmail picker that replaces broken mailto: links",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "generate:providers": "tsx tools/provider-generator/src/index.ts",
    "validate:providers": "tsx tools/provider-validator/index.ts",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@chromatic-com/playwright": "^0.14.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ]
}
